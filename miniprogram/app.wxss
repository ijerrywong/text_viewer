/**
 * app.wxss - 全局基础样式
 *
 * 主题与全部设计令牌都在 styles/tokens.wxss 里，那个文件由
 * `node scripts/gen_tokens.js` 从 core/tokens/design.js 生成 ——
 * 同一批数值 JS 侧（core/render 的高度预估）也要用，只能有一个真源。
 *
 * 这里只放不属于令牌的**通用类**：按钮、卡片、分割线、省略、加载点。
 * 具体数值一律走 var(--xxx)，不写字面量（tests/test-tokens.js 会拦）。
 */

@import "styles/tokens.wxss";

/* ========== 全局基础样式 ========== */
view, text {
  box-sizing: border-box;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 通用按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-6) var(--space-8);
  border-radius: var(--radius-xl);
  font-size: var(--text-xl);
  transition: opacity var(--motion-fast);
}

.btn:active {
  opacity: 0.7;
}

.btn-primary {
  background-color: var(--accent);
  color: var(--on-accent);
}

.btn-secondary {
  background-color: var(--bg-tertiary);
  color: var(--text-primary);
}

.btn-outline {
  border: var(--bw-hairline) solid var(--border);
  color: var(--text-primary);
}

/* 卡片 */
.card {
  background-color: var(--bg-primary);
  border-radius: var(--radius-2xl);
  padding: var(--space-8);
  box-shadow: 0 var(--bw-thick) var(--space-3) var(--shadow);
}

/* 分割线 */
.divider {
  height: var(--bw-hairline);
  background-color: var(--border);
}

/* 文本省略 */
.ellipsis-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 加载中 */
.loading-dots {
  display: flex;
  gap: var(--space-2);
  justify-content: center;
}

.loading-dots text {
  width: var(--space-3);
  height: var(--space-3);
  border-radius: var(--radius-full);
  background-color: var(--text-tertiary);
}
