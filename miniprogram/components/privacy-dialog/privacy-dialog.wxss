/* 隐私授权弹窗
 * 样式从 pages/index/index.wxss 搬来，改成组件后两个页面共用。
 * 颜色一律走主题变量：CSS 自定义属性会穿透组件样式隔离正常继承，
 * 所以深色/护眼主题下弹窗会跟着变，不会像原生 wx.showModal 那样跟系统跑。
 *
 * 数值同理走令牌（styles/tokens.wxss），不写字面量。 */

.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--mask-strong);
  z-index: var(--z-dialog);
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-dialog {
  width: var(--size-drawer-max-width);
  padding: var(--space-12) var(--space-10);
  background-color: var(--bg-primary);
  border-radius: var(--radius-4xl);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.privacy-title {
  font-size: var(--text-3xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-6);
}

.privacy-desc {
  font-size: var(--text-md);
  color: var(--text-secondary);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-10);
}

.privacy-actions {
  display: flex;
  gap: var(--space-6);
  width: 100%;
}

/* 两个按钮要长得一样，但「同意」必须是 button 组件（open-type 的要求），
 * 「拒绝」是 view。button 自带一堆默认样式，得先抹平再套统一外观。 */
.privacy-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--size-button-height);
  padding: 0;
  margin: 0;
  border-radius: var(--radius-xl);
  font-size: var(--text-xl);
  font-weight: var(--weight-normal);
  line-height: 1;
}

/* 去掉 button 组件的默认 1px 边框 */
.privacy-btn::after {
  border: none;
}

.privacy-btn-deny {
  border: var(--bw-hairline) solid var(--border);
  color: var(--text-primary);
  background-color: transparent;
}

.privacy-btn-agree {
  background-color: var(--accent);
  color: var(--on-accent);
}

.privacy-btn-agree:active,
.privacy-btn-deny:active {
  opacity: 0.7;
}
