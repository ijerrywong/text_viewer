<!--
  index.wxml - 首页
  三大入口：从聊天选文件（主位，ADR-12）/ 粘贴文本 / 查看示例
  最近文件列表
-->
<view class="page {{themeClass}}">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <!--
      ADR-15：导航栏只留标题。设置不是首屏该占位置的东西 ——
      它既不高频，也不是打开一份文档的必经之路。
      入口下沉到页尾隐私脚注（那里本来就写着「可在设置中关闭」）。
    -->
    <view class="nav-bar-content" style="height: {{navContentHeight}}px; padding-right: {{navRightInset}}px;">
      <text class="nav-title">纯文本阅读器</text>
    </view>
  </view>

  <!-- 占位（导航栏高度） -->
  <view style="height: {{navBarHeight}}px;"></view>

  <!-- 主体内容 -->
  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{false}}">

    <!--
      朋友圈单页模式（scene 1154）横幅
      平台在这个模式下禁掉了页面跳转、选文件、剪贴板，下面三个入口一个都用不了。
      不说明的话，用户点每一个按钮都得不到任何反馈，只会认为小程序坏了。
    -->
    <view class="single-page-banner" wx:if="{{singlePage}}">
      <text class="single-page-title">朋友圈预览模式</text>
      <text class="single-page-desc">这里只能浏览当前页面。点右上角「···」→「打开小程序」即可选择文件、粘贴文本。</text>
    </view>

    <!--
      Hero 区
      ADR-13：这里是用户最初 3 秒的判断位，要回答的是「这能解决我现在的问题吗」，
      不是「我该不该担心」。隐私文案下沉到页尾 privacy-note。
    -->
    <view class="hero">
      <!--
        标题是一句话，就排成一行 —— 折成两行会让人先读出两个短句再拼回去。
        描述两行是**两条信息**，亲密性要求它们彼此分开，所以仍然分组并给间距。
      -->
      <text class="hero-title">手机收到的文档，这里直接读</text>
      <view class="hero-descs">
        <text class="hero-desc">点开满屏 # 和 *？这里给你排回原样</text>
        <text class="hero-desc">Markdown / HTML / TXT · GBK 自动识别</text>
      </view>
    </view>

    <!--
      三大入口
      ADR-12（2026-08-27 修正记录）：主位归 chooseMessageFile。
      理由是「被迫性」——收到一个微信打不开的 .md 时用户没有别的办法，这是真空；
      而粘贴是主动动作，用户人在 AI app 里，那儿已经渲染好了，他不必复制出来。
      粘贴入口零成本、有真实但低频的用途，因此不删，退居第二位。
      ⚠️ 不要再依据 AGENTS.md 旧版「AI 时代最高频场景」把粘贴提回主位，该定位已作废。
    -->
    <view class="entries">
      <!-- 从聊天选文件（主位）-->
      <view class="entry-card entry-primary" bindtap="chooseFile">
        <view class="entry-icon-wrap">
          <image class="entry-icon" src="{{icons.entryChat}}" mode="aspectFit"/>
        </view>
        <view class="entry-body">
          <text class="entry-title">从聊天选择文件</text>
          <text class="entry-desc">微信打不开的 md / html，选进来就能读</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>

      <!-- 粘贴文本（第二位）-->
      <view class="entry-card" bindtap="pasteText">
        <view class="entry-icon-wrap">
          <image class="entry-icon" src="{{icons.entryPaste}}" mode="aspectFit"/>
        </view>
        <view class="entry-body">
          <text class="entry-title">粘贴文本</text>
          <text class="entry-desc">AI 回复、长文，复制过来直接读</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>

      <!-- 查看示例 -->
      <view class="entry-card" bindtap="viewSamples">
        <view class="entry-icon-wrap">
          <image class="entry-icon" src="{{icons.entrySample}}" mode="aspectFit"/>
        </view>
        <view class="entry-body">
          <text class="entry-title">查看示例</text>
          <text class="entry-desc">体验 Markdown / HTML / TXT 渲染效果</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>
    </view>

    <!-- 最近文件 -->
    <view class="section" wx:if="{{recentFiles.length > 0}}">
      <view class="section-header">
        <text class="section-title">最近文件</text>
        <text class="section-action" bindtap="clearRecent">清空</text>
      </view>
      <view class="recent-list">
        <view
          class="recent-item"
          wx:for="{{recentFiles}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openRecent"
        >
          <view class="recent-info">
            <text class="recent-name ellipsis-1">{{item.name}}</text>
            <text class="recent-meta">{{item.sizeText}} · {{item.timeText}}</text>
          </view>
          <view class="recent-format">{{item.format}}</view>
        </view>
      </view>
    </view>

    <!--
      隐私说明（ADR-13：从 hero badge 下沉至此）
      技术事实没变 —— 本地解析、零 wx.request/downloadFile。
      但网络图片默认开启后，「不联网」这种说法对用户就不再准确了：
      <image> 会由用户设备直接向图床发起加载。这里必须写明，且给出关掉的去处。
    -->
    <!--
      ADR-15：这里是首页**唯一**的设置入口。去掉导航栏齿轮后，
      没打开过任何文档的新用户就只剩这一条路 —— 那句「可在设置中关闭」
      不能是句空话，所以第二行整体可点。
    -->
    <view class="privacy-note">
      <text class="privacy-note-text">文档在本机解析，内容不上传服务器</text>
      <!--
        E9 / 隐私说明 §5.2：iOS 读剪贴板会弹系统级提示「XX 读取了你的剪贴板」，
        这个挡不住，事先说清「点了才读、读了不上传」能显著降低"被偷看"的观感。
        此前这句是粘贴卡的第三行小字，但那让三张并列的入口卡高度不一致
        （违反重复原则），所以移到这段本来就在讲隐私的脚注里。
        ⚠️ 这句是 P0 要求，不要顺手删掉；要改位置先看 Edge-Cases 清单 E9。
      -->
      <text class="privacy-note-text">剪贴板只在你点「粘贴文本」时读一次，不上传</text>
      <text class="privacy-note-text privacy-note-link" bindtap="goSettings">文档里的网络图片由你的手机直接加载，可在设置中关闭 ›</text>
    </view>

    <view class="page-tail"></view>
  </scroll-view>

  <!-- 隐私授权弹窗（共享组件；「同意」必须是 open-type 按钮，见组件内注释） -->
  <privacy-dialog visible="{{showPrivacy}}" bindagree="grantPrivacy" binddeny="denyPrivacy" />
</view>
