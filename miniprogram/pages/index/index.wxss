/* index.wxss - 首页样式 */

/* height 必须是确定值，不能只给 min-height。
 * 下面 .content 是 `flex:1; height:0` 的 scroll-view：
 * 容器高度为 auto（min-height 只是下限）时，这个弹性项在部分 WebView 里
 * 会解析成 0 高 —— 导航栏是 position:fixed 照常画出来，正文却整块不见，
 * 表现就是"打开一片空白"。模拟器按规范把 min-height 计入弹性布局，所以复现不出来。 */
.page {
  height: 100vh;
  background-color: var(--bg-secondary);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 自定义导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: var(--bg-primary);
}

.nav-bar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.nav-settings {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: var(--bg-tertiary);
}

.nav-settings text {
  font-size: 36rpx;
  color: var(--text-secondary);
}

/* 主体 */
.content {
  flex: 1;
  height: 0;
}

/* Hero 区 */
.hero {
  padding: 48rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-badge {
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
  background-color: var(--accent-bg);
  margin-bottom: 24rpx;
}

.hero-badge-text {
  font-size: 22rpx;
  color: var(--accent);
  letter-spacing: 1rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
}

/* 入口卡片 */
.entries {
  padding: 16rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background-color: var(--bg-primary);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx var(--shadow);
}

.entry-primary {
  background-color: var(--accent);
}

.entry-primary .entry-title,
.entry-primary .entry-desc,
.entry-primary .entry-arrow {
  color: #ffffff;
}

.entry-primary .entry-icon-wrap {
  background-color: rgba(255, 255, 255, 0.2);
}

.entry-primary .entry-icon {
  color: #ffffff;
}

.entry-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background-color: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-icon {
  font-size: 40rpx;
  color: var(--accent);
}

.entry-body {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.entry-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

/* 区块标题 */
.section {
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-action {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 最近文件列表 */
.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: var(--bg-primary);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx var(--shadow);
}

.recent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.recent-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.recent-meta {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

.recent-format {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background-color: var(--accent-bg);
  font-size: 22rpx;
  color: var(--accent);
  text-transform: uppercase;
  flex-shrink: 0;
}

/* 提示卡片 */
.tip-card {
  margin: 0 32rpx 32rpx;
  padding: 24rpx 28rpx;
  background-color: var(--accent-bg);
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--accent);
  line-height: 1.6;
}

.tip-close {
  font-size: 28rpx;
  color: var(--accent);
  opacity: 0.6;
  flex-shrink: 0;
}

