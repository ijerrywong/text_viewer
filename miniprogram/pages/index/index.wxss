/* index.wxss - 首页样式
 *
 * 数值一律走令牌（styles/tokens.wxss，由 core/tokens/design.js 生成）。
 * 不要在这里写 rpx / 色值字面量 —— tests/test-tokens.js 会拦。
 */

/* height 必须是确定值，不能只给 min-height。
 * 下面 .content 是 `flex:1; height:0` 的 scroll-view：
 * 容器高度为 auto（min-height 只是下限）时，这个弹性项在部分 WebView 里
 * 会解析成 0 高 —— 导航栏是 position:fixed 照常画出来，正文却整块不见，
 * 表现就是"打开一片空白"。模拟器按规范把 min-height 计入弹性布局，所以复现不出来。 */
.page {
  height: 100vh;
  background-color: var(--bg-secondary);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 自定义导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-nav-bar);
  background-color: var(--bg-primary);
}

.nav-bar-content {
  height: var(--size-nav-bar-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-8);
}

.nav-title {
  font-size: var(--text-4xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.nav-settings {
  width: var(--size-nav-icon);
  height: var(--size-nav-icon);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background-color: var(--bg-tertiary);
}

.nav-settings-icon {
  font-size: var(--text-4xl);
  color: var(--text-secondary);
}

/* 主体 */
.content {
  flex: 1;
  height: 0;
}

/* Hero 区 */
.hero {
  padding: var(--space-12) var(--space-8) var(--space-8);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-badge {
  padding: var(--space-2) var(--space-6);
  border-radius: var(--radius-pill);
  background-color: var(--accent-bg);
  margin-bottom: var(--space-6);
}

.hero-badge-text {
  font-size: var(--text-xs);
  color: var(--accent);
  letter-spacing: var(--tracking-wide);
}

/* 标题组：两行是一句话，靠行距贴合，行间不再加外边距 */
.hero-titles {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-4);
}

.hero-title {
  font-size: var(--text-6xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  text-align: center;
  line-height: var(--leading-tight);
}

/* 描述组：两行是两条信息，给一格间距区分开 */
.hero-descs {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
}

.hero-desc {
  font-size: var(--text-md);
  color: var(--text-secondary);
  text-align: center;
  line-height: var(--leading-normal);
}

/* 入口卡片 */
.entries {
  padding: var(--space-4) var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.entry-card {
  display: flex;
  align-items: center;
  padding: var(--space-8);
  background-color: var(--bg-primary);
  border-radius: var(--radius-3xl);
  box-shadow: var(--shadow-card-xl) var(--shadow);
}

.entry-primary {
  background-color: var(--accent);
}

.entry-primary .entry-title,
.entry-primary .entry-desc,
.entry-primary .entry-arrow {
  color: var(--on-accent);
}

.entry-primary .entry-icon-wrap {
  background-color: var(--on-accent-bg);
}

.entry-primary .entry-icon {
  color: var(--on-accent);
}

.entry-icon-wrap {
  width: var(--size-entry-icon);
  height: var(--size-entry-icon);
  border-radius: var(--radius-2xl);
  background-color: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-icon {
  font-size: var(--text-5xl);
  color: var(--accent);
}

.entry-body {
  flex: 1;
  margin-left: var(--space-6);
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: var(--text-2xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-1);
}

.entry-desc {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

/* 入口卡片里的小字标注（剪贴板「点了才读」的事先说明） */
.entry-note {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  margin-top: var(--space-2);
}

.entry-primary .entry-note {
  color: var(--on-accent-dim);
}

.entry-arrow {
  font-size: var(--text-2xl);
  color: var(--text-tertiary);
}

/* 区块标题 */
.section {
  padding: var(--space-8);
}

/* 标题到列表用 space-6，列表项之间是 space-4 —— 拉开一档，
   分组标题才明确「统领」下面这一组，而不是和它们并列 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-6);
}

.section-title {
  font-size: var(--text-xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

/* 「清空」是可点操作，此前用三级灰 + 无边框，和旁边的纯文字标题几乎同重，
   看不出能点。给它一个轻量的可点形态：强调色 + 一圈描边 + 更小的字号，
   与右侧列表项里的 .recent-format 标签共用同一套形状语言。 */
.section-action {
  font-size: var(--text-sm);
  color: var(--accent);
  padding: var(--space-1) var(--space-3);
  border: var(--bw-hairline) solid var(--border);
  border-radius: var(--radius-md);
}

.section-action:active {
  background-color: var(--accent-bg);
  opacity: 0.7;
}

/* 最近文件列表 */
.recent-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.recent-item {
  display: flex;
  align-items: center;
  padding: var(--space-6) var(--space-8);
  background-color: var(--bg-primary);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card) var(--shadow);
}

.recent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.recent-name {
  font-size: var(--text-lg);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.recent-meta {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  margin-top: var(--space-2);
}

.recent-format {
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-md);
  background-color: var(--accent-bg);
  font-size: var(--text-xs);
  color: var(--accent);
  text-transform: uppercase;
  flex-shrink: 0;
}

/* 提示卡片 */
.tip-card {
  margin: 0 var(--space-8) var(--space-8);
  padding: var(--space-6);
  background-color: var(--accent-bg);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: flex-start;
  gap: var(--space-4);
}

.tip-text {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--accent);
  line-height: var(--leading-normal);
}

.tip-close {
  font-size: var(--text-lg);
  color: var(--accent);
  opacity: 0.6;
  flex-shrink: 0;
}

/* 页尾隐私说明（ADR-13：从 hero badge 下沉，弱化为脚注） */
.privacy-note {
  padding: var(--space-2) var(--space-8) 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
}

.privacy-note-text {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  text-align: center;
  line-height: var(--leading-normal);
}

/* 隐私弹窗样式已移入 components/privacy-dialog/ */

/* 朋友圈单页模式横幅（scene 1154，平台禁用跳转/选文件/剪贴板） */
.single-page-banner {
  margin: var(--space-6) var(--space-8) 0;
  padding: var(--space-6);
  background-color: var(--accent-bg);
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.single-page-title {
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--accent);
}

.single-page-desc {
  font-size: var(--text-sm);
  color: var(--accent);
  line-height: var(--leading-normal);
}

/* 页尾留白：底部工具栏/安全区之外再垫一段，最后一条内容不会贴边 */
.page-tail {
  height: var(--size-spinner);
}
