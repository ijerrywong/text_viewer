/* index.wxss - 首页样式
 *
 * 数值一律走令牌（styles/tokens.wxss，由 core/tokens/design.js 生成）。
 * 不要在这里写 rpx / 色值字面量 —— tests/test-tokens.js 会拦。
 */

/* height 必须是确定值，不能只给 min-height。
 * 下面 .content 是 `flex:1; height:0` 的 scroll-view：
 * 容器高度为 auto（min-height 只是下限）时，这个弹性项在部分 WebView 里
 * 会解析成 0 高 —— 导航栏是 position:fixed 照常画出来，正文却整块不见，
 * 表现就是"打开一片空白"。模拟器按规范把 min-height 计入弹性布局，所以复现不出来。 */
.page {
  height: 100vh;
  background-color: var(--bg-secondary);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 自定义导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-nav-bar);
  background-color: var(--bg-primary);
}

.nav-bar-content {
  height: var(--size-nav-bar-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-8);
}

.nav-title {
  font-size: var(--text-4xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.nav-settings {
  width: var(--size-nav-icon);
  height: var(--size-nav-icon);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background-color: var(--bg-tertiary);
}

.nav-settings-icon {
  font-size: var(--text-4xl);
  color: var(--text-secondary);
}

/* 主体 */
.content {
  flex: 1;
  height: 0;
}

/* Hero 区
 *
 * 对齐：全页只有一条左边线（页面内边距 var(--space-8)），hero、入口卡、
 * 最近文件、页尾脚注一律贴着它。此前 hero 和页尾居中、中间的卡片左对齐 ——
 * 一页两套对齐，边线互相看不见，整块就散了。
 * 方向选左不选中：入口卡是「图标 + 文字 + 箭头」的横向行，天生左起，
 * 居不了中；能统一的只有让上下都退到左边。 */
/* 下内边距比上一档大（space-10 而非 space-8）：说明文字与入口卡之间要有一段
 * 明确的空白，这是「介绍」与「动手」两组之间的界线。加上 .entries 自己的
 * var(--space-4) 上内边距，实际间距 56rpx。 */
.hero {
  padding: var(--space-12) var(--space-8) var(--space-10);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* 标题一行排完。text-6xl(48rpx) × 13 字 = 624rpx，页面可用宽是
 * 750 - var(--space-8) × 2 = 686rpx —— 余 62rpx，还能再放一个字。
 * ⚠️ 这一行的字数是有上限的：14 字就只剩 14rpx，15 字必折。
 *    折成两行等于把一句话读成两个短句，不要让它发生。 */
.hero-title {
  font-size: var(--text-6xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  text-align: left;
  line-height: var(--leading-tight);
  margin-bottom: var(--space-4);
}

/* 描述组：两行是两条信息，给一格间距区分开 */
.hero-descs {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-1);
}

.hero-desc {
  font-size: var(--text-md);
  color: var(--text-secondary);
  text-align: left;
  line-height: var(--leading-normal);
}

/* 入口卡片 */
.entries {
  padding: var(--space-4) var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

/* 三张卡共用一个高度（--size-entry-card-height），锁死而不是各自随文字长。
 * 一组并列的入口必须是同一个矩形反复出现，这是重复原则的最小要求；
 * 哪天某张卡的描述在窄屏上折了行，锁了高度就不会一张比一张高。
 * 高度值的算法写在 core/tokens/design.js 的 SIZE.entryCardHeight。 */
.entry-card {
  display: flex;
  align-items: center;
  min-height: var(--size-entry-card-height);
  padding: var(--space-8);
  background-color: var(--bg-primary);
  border-radius: var(--radius-3xl);
  box-shadow: var(--shadow-card-xl) var(--shadow);
}

.entry-primary {
  background-color: var(--accent);
}

.entry-primary .entry-title,
.entry-primary .entry-desc,
.entry-primary .entry-arrow {
  color: var(--on-accent);
}

.entry-primary .entry-icon-wrap {
  background-color: var(--on-accent-bg);
}

.entry-icon-wrap {
  width: var(--size-entry-icon);
  height: var(--size-entry-icon);
  border-radius: var(--radius-2xl);
  background-color: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 同 .tool-icon：<image> 用尺寸不用字号，颜色在构建时注入 */
.entry-icon {
  width: var(--size-icon-entry);
  height: var(--size-icon-entry);
  display: block;
}

.entry-body {
  flex: 1;
  margin-left: var(--space-6);
  display: flex;
  flex-direction: column;
}

/* 下面三条的 line-height 必须显式写出：卡片高度是按它们算出来的，
 * 交给浏览器默认值就成了不可预测的数，算式也就失去意义。 */
.entry-title {
  font-size: var(--text-2xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  line-height: var(--leading-tight);
  margin-bottom: var(--space-1);
}

.entry-desc {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  line-height: var(--leading-normal);
}

.entry-arrow {
  font-size: var(--text-2xl);
  color: var(--text-tertiary);
}

/* 区块标题 */
.section {
  padding: var(--space-8);
}

/* 标题到列表用 space-6，列表项之间是 space-4 —— 拉开一档，
   分组标题才明确「统领」下面这一组，而不是和它们并列 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-6);
}

.section-title {
  font-size: var(--text-xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

/* 「清空」是可点操作，此前用三级灰 + 无边框，和旁边的纯文字标题几乎同重，
   看不出能点。给它一个轻量的可点形态：强调色 + 一圈描边 + 更小的字号，
   与右侧列表项里的 .recent-format 标签共用同一套形状语言。 */
.section-action {
  font-size: var(--text-sm);
  color: var(--accent);
  padding: var(--space-1) var(--space-3);
  border: var(--bw-hairline) solid var(--border);
  border-radius: var(--radius-md);
}

.section-action:active {
  background-color: var(--accent-bg);
  opacity: 0.7;
}

/* 最近文件列表 */
.recent-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.recent-item {
  display: flex;
  align-items: center;
  padding: var(--space-6) var(--space-8);
  background-color: var(--bg-primary);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card) var(--shadow);
}

.recent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.recent-name {
  font-size: var(--text-lg);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.recent-meta {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  margin-top: var(--space-2);
}

.recent-format {
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-md);
  background-color: var(--accent-bg);
  font-size: var(--text-xs);
  color: var(--accent);
  text-transform: uppercase;
  flex-shrink: 0;
}

/* 提示卡片
 * 四边外边距一律 var(--space-8)：此前上边是 0，只靠上方区块自己的内边距
 * 撑开，于是「卡到上面」和「卡到下面」两段空白不一样宽，卡片看着是被
 * 往上推着走的。上下统一按下间距取值，它才真的悬在两块内容中间。 */
.tip-card {
  margin: var(--space-8);
  padding: var(--space-6);
  background-color: var(--accent-bg);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: flex-start;
  gap: var(--space-4);
}

.tip-text {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--accent);
  line-height: var(--leading-normal);
}

.tip-close {
  font-size: var(--text-lg);
  color: var(--accent);
  opacity: 0.6;
  flex-shrink: 0;
}

/* 页尾隐私说明（ADR-13：从 hero badge 下沉，弱化为脚注） */
/* 与 hero 同理：贴页面左边线，不再居中 */
.privacy-note {
  padding: var(--space-2) var(--space-8) 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
}

.privacy-note-text {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  text-align: left;
  line-height: var(--leading-normal);
}

/* 隐私弹窗样式已移入 components/privacy-dialog/ */

/* 朋友圈单页模式横幅（scene 1154，平台禁用跳转/选文件/剪贴板） */
.single-page-banner {
  margin: var(--space-6) var(--space-8) 0;
  padding: var(--space-6);
  background-color: var(--accent-bg);
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.single-page-title {
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--accent);
}

.single-page-desc {
  font-size: var(--text-sm);
  color: var(--accent);
  line-height: var(--leading-normal);
}

/* 页尾留白：底部工具栏/安全区之外再垫一段，最后一条内容不会贴边 */
.page-tail {
  height: var(--size-spinner);
}

/* ADR-15：去掉导航栏齿轮后，这行脚注是首页唯一的设置入口。
   给它一个可点的暗示（强调色），但不改字号 —— 它仍然是脚注，
   不该在首屏抢视觉重量。 */
.privacy-note-link {
  color: var(--accent);
}

.privacy-note-link:active {
  opacity: 0.6;
}
