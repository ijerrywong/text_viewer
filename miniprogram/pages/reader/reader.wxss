/* reader.wxss - 阅读器样式（Phase 1 + Phase 2）
 *
 * 数值一律走令牌（styles/tokens.wxss，由 core/tokens/design.js 生成）。
 * 不要在这里写 rpx / 色值字面量 —— tests/test-tokens.js 会拦。
 *
 * ⚠️ 带 `--rd-` 前缀的令牌是**与 core/render 高度预估共享的契约**：
 * 那边按同一批数值算块高，两边必须永远相等，否则虚拟滚动会跳
 *（AGENTS §6 门禁第 7 条）。要改就改 core/tokens/design.js 的 READER，
 * 然后 `node scripts/gen_tokens.js`，两边一起变。
 */

/* 同 index.wxss：height 必须确定，否则 `flex:1; height:0` 的
 * .reader-scroll 在部分 WebView 里会塌成 0 高，正文整块不显示 */
.page {
  height: 100vh;
  background-color: var(--reader-bg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ─── 导航栏 ─── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-nav-bar);
  background-color: var(--bg-primary);
  border-bottom: var(--bw-hairline) solid var(--border);
}

.nav-bar-content {
  height: var(--size-nav-bar-height);
  display: flex;
  align-items: center;
  padding: 0 var(--space-6);
  gap: var(--space-4);
}

.nav-back {
  width: var(--size-nav-icon);
  height: var(--size-nav-icon);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
}

.nav-back:active {
  background-color: var(--bg-tertiary);
}

.nav-back-icon {
  font-size: var(--text-5xl);
  color: var(--text-primary);
}

.nav-title {
  flex: 1;
  font-size: var(--text-xl);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.nav-action {
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-lg);
  background-color: var(--bg-tertiary);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  min-width: var(--size-nav-action-min-width);
  text-align: center;
}

.nav-action:active {
  opacity: 0.7;
}

/* ─── 阅读区 ─── */
.reader-scroll {
  flex: 1;
  height: 0;
}

.reader-content {
  padding: var(--rd-content-padding);
}

/* ─── 块级元素 ─── */
.block {
  margin-bottom: var(--rd-block-gap);
}

.block-paragraph {
  font-size: var(--reader-font-size);
  line-height: var(--reader-line-height);
  color: var(--reader-text);
  font-family: var(--font-family);
  word-break: break-all;
  overflow-wrap: break-word;
}

.block-heading {
  font-weight: var(--weight-bold);
  color: var(--reader-heading);
  margin-top: var(--rd-heading-margin-top);
  margin-bottom: var(--rd-heading-margin-bottom);
  font-family: var(--font-family);
}

.block-h1 { font-size: var(--heading-1); }
.block-h2 { font-size: var(--heading-2); }
.block-h3 { font-size: var(--heading-3); }
.block-h4 { font-size: var(--heading-4); }
.block-h5 { font-size: var(--heading-5); }
.block-h6 { font-size: var(--heading-6); color: var(--text-secondary); }

.code-lang {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  text-transform: uppercase;
  font-family: var(--font-mono);
}

.code-text {
  font-family: var(--font-mono);
  font-size: var(--rd-code-font-size);
  line-height: var(--rd-code-leading);
  color: var(--reader-text);
  white-space: pre;
}

.block-hr {
  height: var(--bw-hairline);
  background-color: var(--reader-hr);
  margin: var(--rd-hr-margin) 0;
}

/* ─── 加载状态 ─── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-50) 0;
}

.loading-spinner {
  width: var(--size-spinner);
  height: var(--size-spinner);
  border: var(--bw-focus) solid var(--border);
  border-top-color: var(--accent);
  border-radius: var(--radius-full);
  animation: spin var(--motion-spin) linear infinite;
  margin-bottom: var(--space-6);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--text-md);
  color: var(--text-secondary);
}

/* ─── 空状态 / 错误 ─── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-50) var(--space-16);
}

.empty-icon {
  font-size: var(--text-7xl);
  margin-bottom: var(--space-6);
}

.empty-text {
  font-size: var(--text-lg);
  color: var(--text-secondary);
  text-align: center;
  line-height: var(--leading-normal);
}

/* ─── 进度条 ─── */
.progress-bar-wrap {
  display: flex;
  align-items: center;
  padding: var(--space-2) var(--space-6);
  gap: var(--space-4);
  background-color: var(--bg-primary);
}

.progress-bar {
  flex: 1;
  height: var(--space-1);
  background-color: var(--bg-tertiary);
  border-radius: var(--radius-2xs);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: var(--accent);
  border-radius: var(--radius-2xs);
  transition: width var(--motion-fast) ease;
}

.progress-text {
  font-size: var(--text-2xs);
  color: var(--text-tertiary);
  min-width: var(--size-progress-text-min-width);
  text-align: right;
}

/* ─── 底部工具栏 ─── */
.toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: var(--space-3) 0 calc(var(--space-3) + env(safe-area-inset-bottom));
  background-color: var(--bg-primary);
  border-top: var(--bw-hairline) solid var(--border);
  z-index: var(--z-toolbar);
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-2) var(--space-6);
}

.tool-item:active {
  opacity: 0.6;
}

/* 图标是 <image>，要的是 width/height 而不是 font-size。
   颜色不在这里 —— SVG 在构建时就按主题着好色了（scripts/gen_icons.js），
   image 组件的颜色 CSS 改不了。 */
.tool-icon {
  width: var(--size-icon-toolbar);
  height: var(--size-icon-toolbar);
  display: block;
}

.tool-label {
  font-size: var(--text-2xs);
  color: var(--text-tertiary);
}

/* ─── 目录抽屉 ─── */
.toc-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--mask);
  z-index: var(--z-drawer-mask);
}

.toc-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 75%;
  max-width: var(--size-drawer-max-width);
  background-color: var(--bg-primary);
  z-index: var(--z-drawer-panel);
  transform: translateX(100%);
  transition: transform var(--motion-normal) ease;
  display: flex;
  flex-direction: column;
}

.toc-panel-open {
  transform: translateX(0);
}

.toc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-8);
  border-bottom: var(--bw-hairline) solid var(--border);
}

.toc-title {
  font-size: var(--text-2xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.toc-close {
  font-size: var(--text-2xl);
  color: var(--text-tertiary);
  padding: var(--space-2);
}

.toc-list {
  flex: 1;
  padding: var(--space-4) 0;
}

.toc-empty {
  padding: var(--space-16) var(--space-8);
  text-align: center;
  color: var(--text-tertiary);
  font-size: var(--text-md);
}

.toc-item {
  padding: var(--space-5) var(--space-8);
  font-size: var(--text-lg);
  color: var(--text-primary);
  border-bottom: var(--bw-hairline) solid var(--border);
}

.toc-item:active {
  background-color: var(--bg-tertiary);
}

/* 逐级缩进：每级加一个 --space-6（24rpx），
   与 core/render 的目录缩进无关，纯视觉层次 */
.toc-level-1 { padding-left: var(--space-8); font-weight: var(--weight-semibold); }
.toc-level-2 { padding-left: calc(var(--space-8) + var(--space-6)); }
.toc-level-3 { padding-left: calc(var(--space-8) + var(--space-6) * 2); font-size: var(--text-md); color: var(--text-secondary); }
.toc-level-4 { padding-left: calc(var(--space-8) + var(--space-6) * 3); font-size: var(--text-md); color: var(--text-secondary); }
.toc-level-5 { padding-left: calc(var(--space-8) + var(--space-6) * 4); font-size: var(--text-sm); color: var(--text-tertiary); }
.toc-level-6 { padding-left: calc(var(--space-8) + var(--space-6) * 5); font-size: var(--text-sm); color: var(--text-tertiary); }

/* ─── 搜索 · 输入态浮层 ───
   页面是 navigationStyle:custom，屏幕顶端归微信管：
   状态栏压着 y=0，右上角胶囊（···／关闭）盖不掉也移不走。
   所以搜索不上顶部，改成居中浮层。 */
.search-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  /* bottom 由 JS 按键盘高度下发：可用区变矮，卡片自然被顶到键盘上方 */
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--mask-strong);
  z-index: var(--z-search-mask);
}

/* max-height 是给结果列表用的：
   有了确定的容器高度，下面那个 flex:1 的 scroll-view 才能被正确压缩，
   键盘弹起时卡片也不会顶出可用区。 */
.search-modal {
  width: 86%;
  max-width: var(--size-modal-max-width);
  max-height: calc(100% - var(--space-12));
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-6);
  background-color: var(--bg-primary);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-modal) var(--shadow);
  overflow: hidden;
}

.search-modal-hint {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
  text-align: center;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--bg-tertiary);
  border-radius: var(--radius-lg);
  padding: 0 var(--space-5);
  height: var(--size-input-height);
}

.search-icon {
  font-size: var(--text-lg);
  color: var(--text-tertiary);
  margin-right: var(--space-3);
}

.search-input {
  flex: 1;
  font-size: var(--text-lg);
  color: var(--text-primary);
}

.search-clear {
  font-size: var(--text-lg);
  color: var(--text-tertiary);
}

/* ─── 搜索 · 结果态窄条 ───
   贴在底部工具栏正上方（bottom 由 JS 下发 = toolbarHeight，已含底部安全区）。
   只占一行，正文和命中高亮完全露出；拇指不用横跨屏幕去够顶端。 */
.search-navbar {
  position: fixed;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-6);
  background-color: var(--bg-primary);
  border-top: var(--bw-hairline) solid var(--border);
  box-shadow: var(--shadow-bar-up) var(--shadow);
  z-index: var(--z-search-bar);
}

.search-navbar-kw {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-2);
}

.search-navbar-kw-text {
  font-size: var(--text-md);
  color: var(--text-secondary);
}

.search-navbar-count {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
  white-space: nowrap;
}

.search-navbar-close {
  padding: 0 var(--space-2);
  font-size: var(--text-xl);
  color: var(--text-tertiary);
}

/* ════════════════════════════════════════════
   Phase 2 样式
   ════════════════════════════════════════════ */

/* ─── 行内段（inline-segments 模板） ─── */
.seg-code {
  font-family: var(--font-mono);
  font-size: var(--em-code);
  background-color: var(--reader-code-bg);
  color: var(--reader-text);
  padding: var(--space-half) var(--space-2);
  border-radius: var(--radius-sm);
}

.seg-link {
  color: var(--reader-link);
  text-decoration: underline;
}

.seg-footref {
  font-size: var(--em-sup);
  color: var(--reader-link);
  vertical-align: super;
}

.seg-img-ph {
  font-size: var(--em-hint);
  color: var(--text-tertiary);
  font-family: var(--font-mono);
}

/* ─── 搜索命中高亮 ───
   seg-hl：所有命中的词；seg-hl-cur：当前所在结果那一块里的词。
   两级配色是必要的 —— 一屏几十个黄块时，「我现在在第几个」得靠颜色区分。
   !important 是为了压过 .seg-code / .seg-link 自带的底色和字色。 */
.seg-hl {
  background-color: var(--search-hl-bg) !important;
  color: var(--search-hl-text) !important;
  border-radius: var(--radius-xs);
}

.seg-hl-cur {
  background-color: var(--search-hl-cur-bg) !important;
  color: var(--search-hl-cur-text) !important;
}

/* ─── 列表项 ─── */
.block-list-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--space-3);
  font-size: var(--reader-font-size);
  line-height: var(--reader-line-height);
  color: var(--reader-text);
  font-family: var(--font-family);
  padding-top: var(--space-1);
  padding-bottom: var(--space-1);
}

.list-marker {
  flex-shrink: 0;
  min-width: var(--size-list-marker-min-width);
  font-size: var(--reader-font-size);
  color: var(--text-secondary);
  line-height: var(--reader-line-height);
}

.list-text {
  flex: 1;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* ─── 引用块 ─── */
.block-quote {
  border-left: var(--bw-accent) solid var(--accent);
  background-color: var(--reader-blockquote-bg);
  border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  padding: var(--rd-quote-padding-y) var(--rd-quote-padding-x);
}

.quote-text {
  color: var(--reader-blockquote);
  font-size: var(--em-quote);
  line-height: var(--reader-line-height);
  word-break: break-all;
  overflow-wrap: break-word;
}

/* ─── 代码块 ─── */
.block-code {
  background-color: var(--reader-code-bg);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.code-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-6);
  border-bottom: var(--bw-hairline) solid var(--border);
}

.code-copy-btn {
  font-size: var(--text-sm);
  color: var(--accent);
  padding: var(--space-1) var(--space-4);
  border: var(--bw-hairline) solid var(--accent);
  border-radius: var(--radius-md);
}

.code-copy-btn:active {
  opacity: 0.6;
}

.code-scroll {
  padding: var(--rd-code-padding);
  white-space: nowrap;
}

.code-hint {
  display: block;
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  padding: var(--space-2) var(--space-6) var(--space-4);
  font-style: italic;
}

/* ─── 语法高亮 token 颜色 ───
   三套主题的配色都在 core/tokens/design.js 的主题表里，
   随主题变量一起切换 —— 此前这里为每套主题各写了一份 `.theme-dark .code-tok-*`
   覆盖块，游离在主题系统之外，加一套主题就要来这儿补一遍。 */
.code-tok-keyword { color: var(--code-tok-keyword); }
.code-tok-string { color: var(--code-tok-string); }
.code-tok-comment { color: var(--code-tok-comment); font-style: italic; }
.code-tok-number { color: var(--code-tok-number); }
.code-tok-function { color: var(--code-tok-function); }
.code-tok-operator { color: var(--code-tok-operator); }
.code-tok-plain { color: var(--reader-text); }

/* ─── 表格 ─── */
.block-table {
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.table-scroll {
  width: 100%;
}

/* 用 CSS 表格布局而非 flex：flex 的每一行都是独立容器，行与行之间没有
   列宽协商，一格内容变宽就把该行后面的竖线整体推开，各行竖线对不齐。
   display:table 由渲染引擎统一协商列宽，同列必然同宽。 */
.table-inner {
  display: inline-table;
  border-collapse: collapse;
  min-width: 100%;
}

.table-row {
  display: table-row;
}

.table-header-row {
  background-color: var(--bg-tertiary);
}

/* nowrap：单元格恒为一行，行高可精确预估（见 core/render/index.js 的
   table 分支）。这一组尺寸就是那份预估的输入，两边同源。 */
.table-cell {
  display: table-cell;
  min-width: var(--size-table-cell-min-width);
  padding: var(--rd-table-cell-padding-y) var(--space-5);
  font-size: var(--rd-table-cell-font-size);
  line-height: var(--rd-table-cell-leading);
  color: var(--reader-text);
  border-right: var(--rd-table-row-border) solid var(--border);
  border-bottom: var(--rd-table-row-border) solid var(--border);
  white-space: nowrap;
  vertical-align: top;
}

.table-cell:last-child {
  border-right: none;
}

.table-header-row .table-cell {
  border-bottom: var(--bw-thick) solid var(--border);
}

.table-header-cell {
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

/* ─── 图片 ─── */
.block-image {
  text-align: center;
}

.content-image {
  width: 100%;
  border-radius: var(--radius-lg);
  max-width: 100%;
}

.image-alt {
  display: block;
  font-size: var(--text-sm);
  color: var(--text-tertiary);
  margin-top: var(--space-2);
  font-style: italic;
}

/* ─── 网络图片屏蔽占位 ─── */
.image-blocked {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-10) var(--space-6);
  background-color: var(--reader-code-bg);
  border-radius: var(--radius-lg);
  border: var(--bw-thick) dashed var(--border);
}

.image-blocked-icon {
  font-size: var(--text-6xl);
  margin-bottom: var(--space-3);
}

.image-blocked-text {
  font-size: var(--text-md);
  color: var(--text-secondary);
  font-weight: var(--weight-medium);
}

.image-blocked-hint {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  margin-top: var(--space-2);
}

/* ─── 脚本降级块 ─── */
.block-script-degrade {
  margin: var(--space-4) 0;
}

.degrade-card {
  background-color: var(--reader-code-bg);
  border-radius: var(--radius-lg);
  padding: var(--rd-degrade-card-padding);
  border-left: var(--bw-accent) solid var(--accent);
}

.degrade-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.degrade-icon {
  font-size: var(--text-4xl);
}

.degrade-title {
  font-size: var(--rd-degrade-title-size);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.degrade-message {
  display: block;
  font-size: var(--text-md);
  color: var(--text-secondary);
  line-height: var(--leading-normal);
  word-break: break-all;
  overflow-wrap: break-word;
}

.degrade-hint {
  display: block;
  font-size: var(--rd-degrade-hint-size);
  color: var(--text-tertiary);
  margin-top: var(--space-3);
  font-style: italic;
}

/* ─── 脚注 ─── */
.block-footnote {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--space-2);
  font-size: var(--rd-footnote-font-size);
  color: var(--text-secondary);
  line-height: var(--rd-footnote-leading);
  padding: var(--rd-footnote-padding-y) 0;
  border-top: var(--bw-hairline) solid var(--border);
}

.footnote-marker {
  flex-shrink: 0;
  color: var(--reader-link);
  font-weight: var(--weight-medium);
}

.footnote-text {
  flex: 1;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* ─── HTML 块（降级纯文本） ─── */
.block-html {
  background-color: var(--reader-code-bg);
  border-radius: var(--radius-lg);
  padding: var(--rd-html-padding) var(--space-6);
  overflow: hidden;
}

.html-hint {
  display: block;
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  margin-bottom: var(--space-3);
  font-style: italic;
}

.html-text {
  font-family: var(--font-mono);
  font-size: var(--rd-html-font-size);
  line-height: var(--rd-html-leading);
  color: var(--reader-text);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ─── 目录高亮 ─── */
.toc-item-active {
  background-color: var(--accent-bg);
  color: var(--accent) !important;
}

.toc-item-active text {
  color: var(--accent) !important;
}

/* ─── 搜索结果列表（浮层内） ─── */
.search-results-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-4);
}

.search-results-count {
  font-size: var(--text-md);
  color: var(--text-secondary);
}

.search-results-tip {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  white-space: nowrap;
}

.search-nav {
  display: flex;
  flex-direction: row;
  gap: var(--space-4);
}

.search-nav-btn {
  width: var(--size-ctrl-sm);
  height: var(--size-ctrl-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-2xl);
  color: var(--accent);
  border: var(--bw-hairline) solid var(--border);
  border-radius: var(--radius-md);
}

.search-nav-btn:active {
  background-color: var(--bg-tertiary);
}

/* 卡片有了 max-height，这里就能 flex 收缩：
   键盘收起后列表铺满剩余空间（搜索确认后就是这个状态，结果要一次看够），
   键盘还在时被压到 min-height，仍留得下两三条。 */
.search-results-list {
  flex: 1 1 auto;
  min-height: var(--size-search-list-min-height);
  max-height: 52vh;
}

.search-result-item {
  padding: var(--space-5) var(--space-2);
  border-bottom: var(--bw-hairline) solid var(--border);
}

.search-result-item:active {
  background-color: var(--bg-tertiary);
}

.search-result-active {
  background-color: var(--accent-bg);
}

.search-result-snippet {
  font-size: var(--text-md);
  color: var(--reader-text);
  line-height: var(--leading-snug);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ─── 文件队列面板 ─── */
.file-queue-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--mask);
  z-index: var(--z-drawer-mask);
}

.file-queue-panel {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 75%;
  max-width: var(--size-drawer-max-width);
  background-color: var(--bg-primary);
  z-index: var(--z-drawer-panel);
  transform: translateX(-100%);
  transition: transform var(--motion-normal) ease;
  display: flex;
  flex-direction: column;
}

.file-queue-panel-open {
  transform: translateX(0);
}

.file-queue-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-8);
  border-bottom: var(--bw-hairline) solid var(--border);
}

.file-queue-title {
  font-size: var(--text-2xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.file-queue-close {
  font-size: var(--text-2xl);
  color: var(--text-tertiary);
  padding: var(--space-2);
}

.file-queue-list {
  flex: 1;
  padding: var(--space-4) 0;
}

/* 内边距与 .toc-item 一致（space-5）——两个抽屉的 header 已经是同一套样式，
   列表行此前却一个 20rpx 一个 24rpx，两个面板并排看能看出行高不齐。
   高度差异交给内容（这里是两行，目录是一行）去产生，不靠 padding 制造。 */
.file-queue-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: var(--space-5) var(--space-8);
  border-bottom: var(--bw-hairline) solid var(--border);
}

.file-queue-item:active {
  background-color: var(--bg-tertiary);
}

.file-queue-item-active {
  background-color: var(--accent-bg);
}

.file-queue-item-active .file-queue-item-name {
  color: var(--accent);
}

.file-queue-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  overflow: hidden;
}

.file-queue-item-name {
  font-size: var(--text-lg);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.file-queue-item-meta {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
}

.file-queue-item-close {
  width: var(--size-ctrl-sm);
  height: var(--size-ctrl-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-lg);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.file-queue-item-close:active {
  opacity: 0.5;
}

/* ─── 降级/截断提示（§3.2 降级必须可见）───
   底色走 --bg-subtle。这个变量此前**根本没有定义过**，
   三处 `var(--bg-subtle, rgba(127,127,127,0.08))` 一直在吃 fallback，
   于是提示条在三套主题下都是同一个死灰，从没跟过主题。 */

.degrade-notice {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  margin: var(--space-5) var(--space-6) 0;
  padding: var(--space-4) var(--space-5);
  border-radius: var(--radius-lg);
  background: var(--bg-subtle);
  border-left: var(--bw-accent) solid var(--accent);
}

.degrade-notice-icon {
  font-size: var(--text-md);
  line-height: var(--leading-snug);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.degrade-notice-text {
  font-size: var(--text-sm);
  line-height: var(--leading-snug);
  color: var(--text-secondary);
}

/* ─── 粘贴内容显式保存（E10）─── */

.clipboard-save {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  margin: var(--space-5) var(--space-6) 0;
  padding: var(--space-4) var(--space-5);
  border-radius: var(--radius-lg);
  background: var(--bg-subtle);
}

.clipboard-save-text {
  font-size: var(--text-xs);
  line-height: var(--leading-snug);
  color: var(--text-tertiary);
  flex: 1;
}

.clipboard-save-btn {
  font-size: var(--text-sm);
  color: var(--accent);
  padding: var(--space-2) var(--space-4);
  flex-shrink: 0;
}

.clipboard-save-btn:active {
  opacity: 0.5;
}

/* ─── 搜索命中块标记 ───
   必须放在**所有块类型样式之后**：.block-quote / .block-code / .block-html
   都自带 background-color，同为单类选择器时后写的赢 ——
   原先这段写在它们前面，代码块、引用块的命中标记等于没有。

   标记用 inset 左色条而不是铺底色：底色是这些块的身份（代码块的灰、
   引用块的浅底），为了标一次命中把它们涂平不划算；色条叠在任何底色上都看得见。
   当前所在的那一块再额外铺一层暖色，和其余命中拉开距离。 */
.block-hit {
  border-radius: var(--radius-md);
  box-shadow: inset var(--bw-accent) 0 0 0 var(--search-hl-bg);
}

.block-hit-cur {
  background-color: var(--search-hit-bg);
  box-shadow: inset var(--bw-accent) 0 0 0 var(--search-hl-cur-bg);
}

/* 空状态里的返回按钮 */
.empty-action {
  margin-top: var(--space-8);
}

/* ─── 编码疑似误判提示（ADR-15）───
   导航栏原本常驻一个编码切换按钮，对不懂「GBK / Big5」的人是纯噪音。
   改为只在 detect.looksGarbled 判定疑似乱码时出现。
   形状沿用 .degrade-notice 那一套（同为「正文上方的黄条」），
   但左侧色条用 warn 而不是 accent —— 它报告的是一个需要动手的问题，
   不是一条陈述性说明。 */

.encoding-notice {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-3);
  margin: var(--space-5) var(--space-6) 0;
  padding: var(--space-4) var(--space-5);
  border-radius: var(--radius-lg);
  background: var(--bg-subtle);
  border-left: var(--bw-accent) solid var(--warn);
}

.encoding-notice-icon {
  font-size: var(--text-md);
  color: var(--warn);
  flex-shrink: 0;
}

.encoding-notice-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.encoding-notice-text {
  font-size: var(--text-sm);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.encoding-notice-hint {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
}

.encoding-notice-action {
  flex-shrink: 0;
  font-size: var(--text-sm);
  color: var(--accent);
  padding: var(--space-1) var(--space-3);
  border: var(--bw-hairline) solid var(--accent);
  border-radius: var(--radius-md);
}

.encoding-notice:active {
  opacity: 0.7;
}
