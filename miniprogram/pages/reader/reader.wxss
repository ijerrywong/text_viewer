/* reader.wxss - 阅读器样式（Phase 1 + Phase 2） */

/* 同 index.wxss：height 必须确定，否则 `flex:1; height:0` 的
 * .reader-scroll 在部分 WebView 里会塌成 0 高，正文整块不显示 */
.page {
  height: 100vh;
  background-color: var(--reader-bg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ─── 导航栏 ─── */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: var(--bg-primary);
  border-bottom: 1rpx solid var(--border);
}

.nav-bar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 16rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-back:active {
  background-color: var(--bg-tertiary);
}

.nav-back-icon {
  font-size: 40rpx;
  color: var(--text-primary);
}

.nav-title {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-action {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background-color: var(--bg-tertiary);
  font-size: 24rpx;
  color: var(--text-secondary);
  min-width: 48rpx;
  text-align: center;
}

.nav-action:active {
  opacity: 0.7;
}

/* ─── 阅读区 ─── */
.reader-scroll {
  flex: 1;
  height: 0;
}

.reader-content {
  padding: 32rpx;
}

/* ─── 块级元素 ─── */
.block {
  margin-bottom: 24rpx;
}

.block-paragraph {
  font-size: var(--font-size);
  line-height: var(--line-height);
  color: var(--reader-text);
  font-family: var(--font-family);
  word-break: break-all;
  overflow-wrap: break-word;
}

.block-heading {
  font-weight: 700;
  color: var(--reader-heading);
  margin-top: 40rpx;
  margin-bottom: 16rpx;
  font-family: var(--font-family);
}

.block-h1 { font-size: 44rpx; }
.block-h2 { font-size: 38rpx; }
.block-h3 { font-size: 34rpx; }
.block-h4 { font-size: 30rpx; }
.block-h5 { font-size: 28rpx; }
.block-h6 { font-size: 26rpx; color: var(--text-secondary); }

.block-code {
  background-color: var(--reader-code-bg);
  border-radius: 12rpx;
  overflow: hidden;
}

.code-lang {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-transform: uppercase;
  font-family: var(--font-mono);
}

.code-text {
  font-family: var(--font-mono);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--reader-text);
  white-space: pre;
}

.block-hr {
  height: 1rpx;
  background-color: var(--reader-hr);
  margin: 40rpx 0;
}

/* ─── 加载状态 ─── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ─── 空状态 / 错误 ─── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 64rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
}

/* ─── 进度条 ─── */
.progress-bar-wrap {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx;
  gap: 16rpx;
  background-color: var(--bg-primary);
}

.progress-bar {
  flex: 1;
  height: 4rpx;
  background-color: var(--bg-tertiary);
  border-radius: 2rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: var(--accent);
  border-radius: 2rpx;
  transition: width 0.2s ease;
}

.progress-text {
  font-size: 20rpx;
  color: var(--text-tertiary);
  min-width: 60rpx;
  text-align: right;
}

/* ─── 底部工具栏 ─── */
.toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-primary);
  border-top: 1rpx solid var(--border);
  z-index: 50;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 24rpx;
}

.tool-item:active {
  opacity: 0.6;
}

.tool-icon {
  font-size: 36rpx;
  color: var(--text-secondary);
}

.tool-label {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* ─── 目录抽屉 ─── */
.toc-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 200;
}

.toc-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 75%;
  max-width: 600rpx;
  background-color: var(--bg-primary);
  z-index: 201;
  transform: translateX(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.toc-panel-open {
  transform: translateX(0);
}

.toc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.toc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.toc-close {
  font-size: 32rpx;
  color: var(--text-tertiary);
  padding: 8rpx;
}

.toc-list {
  flex: 1;
  padding: 16rpx 0;
}

.toc-empty {
  padding: 64rpx 32rpx;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.toc-item {
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--border);
}

.toc-item:active {
  background-color: var(--bg-tertiary);
}

.toc-level-1 { padding-left: 32rpx; font-weight: 600; }
.toc-level-2 { padding-left: 56rpx; }
.toc-level-3 { padding-left: 80rpx; font-size: 26rpx; color: var(--text-secondary); }
.toc-level-4 { padding-left: 104rpx; font-size: 26rpx; color: var(--text-secondary); }
.toc-level-5 { padding-left: 128rpx; font-size: 24rpx; color: var(--text-tertiary); }
.toc-level-6 { padding-left: 152rpx; font-size: 24rpx; color: var(--text-tertiary); }

/* ─── 搜索栏 ─── */
.search-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: var(--bg-primary);
  border-bottom: 1rpx solid var(--border);
  z-index: 150;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--bg-tertiary);
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.search-cancel {
  font-size: 28rpx;
  color: var(--accent);
  white-space: nowrap;
}

/* ════════════════════════════════════════════
   Phase 2 样式
   ════════════════════════════════════════════ */

/* ─── 行内段（inline-segments 模板） ─── */
.seg-code {
  font-family: var(--font-mono);
  font-size: 0.88em;
  background-color: var(--reader-code-bg);
  color: var(--reader-text);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.seg-link {
  color: var(--reader-link);
  text-decoration: underline;
}

.seg-footref {
  font-size: 0.8em;
  color: var(--reader-link);
  vertical-align: super;
}

.seg-img-ph {
  font-size: 0.85em;
  color: var(--text-tertiary);
  font-family: var(--font-mono);
}

/* ─── 列表项 ─── */
.block-list-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  font-size: var(--font-size);
  line-height: var(--line-height);
  color: var(--reader-text);
  font-family: var(--font-family);
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.list-marker {
  flex-shrink: 0;
  min-width: 40rpx;
  font-size: var(--font-size);
  color: var(--text-secondary);
  line-height: var(--line-height);
}

.list-text {
  flex: 1;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* ─── 引用块 ─── */
.block-quote {
  border-left: 6rpx solid var(--accent);
  background-color: var(--reader-blockquote-bg);
  border-radius: 0 12rpx 12rpx 0;
  padding: 20rpx 24rpx;
}

.quote-text {
  color: var(--reader-blockquote);
  font-size: 0.96em;
  line-height: var(--line-height);
  word-break: break-all;
  overflow-wrap: break-word;
}

/* ─── 代码块增强 ─── */
.block-code {
  background-color: var(--reader-code-bg);
  border-radius: 12rpx;
  overflow: hidden;
}

.code-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.code-copy-btn {
  font-size: 24rpx;
  color: var(--accent);
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--accent);
  border-radius: 8rpx;
}

.code-copy-btn:active {
  opacity: 0.6;
}

.code-scroll {
  padding: 24rpx;
  white-space: nowrap;
}

.code-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 8rpx 24rpx 16rpx;
  font-style: italic;
}

/* ─── 语法高亮 token 颜色 ─── */
.code-tok-keyword { color: #d73a49; }
.code-tok-string { color: #032f62; }
.code-tok-comment { color: #6a737d; font-style: italic; }
.code-tok-number { color: #005cc5; }
.code-tok-function { color: #6f42c1; }
.code-tok-operator { color: #d73a49; }
.code-tok-plain { color: var(--reader-text); }

/* 深色主题代码高亮 */
.theme-dark .code-tok-keyword { color: #ff7b72; }
.theme-dark .code-tok-string { color: #a5d6ff; }
.theme-dark .code-tok-comment { color: #8b949e; }
.theme-dark .code-tok-number { color: #79c0ff; }
.theme-dark .code-tok-function { color: #d2a8ff; }
.theme-dark .code-tok-operator { color: #ff7b72; }
.theme-dark .code-tok-plain { color: var(--reader-text); }

/* 护眼主题代码高亮 */
.theme-sepia .code-tok-keyword { color: #8b4513; }
.theme-sepia .code-tok-string { color: #556b2f; }
.theme-sepia .code-tok-comment { color: #a89880; }
.theme-sepia .code-tok-number { color: #8b6914; }
.theme-sepia .code-tok-function { color: #6b4226; }
.theme-sepia .code-tok-operator { color: #8b4513; }
.theme-sepia .code-tok-plain { color: var(--reader-text); }

/* ─── 表格 ─── */
.block-table {
  border-radius: 12rpx;
  overflow: hidden;
}

.table-scroll {
  width: 100%;
}

.table-inner {
  display: inline-flex;
  flex-direction: column;
  min-width: 100%;
}

.table-row {
  display: flex;
  flex-direction: row;
  border-bottom: 1rpx solid var(--border);
}

.table-header-row {
  background-color: var(--bg-tertiary);
  border-bottom: 2rpx solid var(--border);
}

.table-cell {
  flex-shrink: 0;
  min-width: 160rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--reader-text);
  border-right: 1rpx solid var(--border);
  word-break: break-all;
  overflow-wrap: break-word;
}

.table-cell:last-child {
  border-right: none;
}

.table-header-cell {
  font-weight: 600;
  color: var(--text-primary);
}

/* ─── 图片 ─── */
.block-image {
  text-align: center;
}

.content-image {
  width: 100%;
  border-radius: 12rpx;
  max-width: 100%;
}

.image-alt {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  font-style: italic;
}

/* ─── 网络图片屏蔽占位 ─── */
.image-blocked {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx;
  background-color: var(--reader-code-bg);
  border-radius: 12rpx;
  border: 2rpx dashed var(--border);
}

.image-blocked-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.image-blocked-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.image-blocked-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* ─── 脚本降级块 ─── */
.block-script-degrade {
  margin: 16rpx 0;
}

.degrade-card {
  background-color: var(--reader-code-bg);
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid var(--accent);
}

.degrade-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.degrade-icon {
  font-size: 36rpx;
}

.degrade-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.degrade-message {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  word-break: break-all;
  overflow-wrap: break-word;
}

.degrade-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
  font-style: italic;
}

/* ─── 脚注 ─── */
.block-footnote {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  padding: 8rpx 0;
  border-top: 1rpx solid var(--border);
}

.footnote-marker {
  flex-shrink: 0;
  color: var(--reader-link);
  font-weight: 500;
}

.footnote-text {
  flex: 1;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* ─── HTML 块（降级纯文本） ─── */
.block-html {
  background-color: var(--reader-code-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  overflow: hidden;
}

.html-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
  font-style: italic;
}

.html-text {
  font-family: var(--font-mono);
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--reader-text);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ─── 目录高亮 ─── */
.toc-item-active {
  background-color: var(--accent-bg);
  color: var(--accent) !important;
}

.toc-item-active text {
  color: var(--accent) !important;
}

/* ─── 搜索结果面板 ─── */
.search-results-panel {
  position: fixed;
  top: 104rpx;
  left: 0;
  right: 0;
  max-height: 50vh;
  background-color: var(--bg-primary);
  border-bottom: 1rpx solid var(--border);
  z-index: 149;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}

.search-results-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.search-results-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.search-nav {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.search-nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--accent);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
}

.search-nav-btn:active {
  background-color: var(--bg-tertiary);
}

.search-results-list {
  flex: 1;
  max-height: 40vh;
}

.search-result-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.search-result-item:active {
  background-color: var(--bg-tertiary);
}

.search-result-active {
  background-color: var(--accent-bg);
}

.search-result-snippet {
  font-size: 26rpx;
  color: var(--reader-text);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ─── 文件队列面板 ─── */
.file-queue-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 200;
}

.file-queue-panel {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 75%;
  max-width: 600rpx;
  background-color: var(--bg-primary);
  z-index: 201;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.file-queue-panel-open {
  transform: translateX(0);
}

.file-queue-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.file-queue-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.file-queue-close {
  font-size: 32rpx;
  color: var(--text-tertiary);
  padding: 8rpx;
}

.file-queue-list {
  flex: 1;
  padding: 16rpx 0;
}

.file-queue-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.file-queue-item:active {
  background-color: var(--bg-tertiary);
}

.file-queue-item-active {
  background-color: var(--accent-bg);
}

.file-queue-item-active .file-queue-item-name {
  color: var(--accent);
}

.file-queue-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.file-queue-item-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.file-queue-item-meta {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.file-queue-item-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.file-queue-item-close:active {
  opacity: 0.5;
}

/* ─── 降级/截断提示（§3.2 降级必须可见）─── */

.degrade-notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 20rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-subtle, rgba(127, 127, 127, 0.08));
  border-left: 6rpx solid var(--accent, #4f46e5);
}

.degrade-notice-icon {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.degrade-notice-text {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

/* ─── 粘贴内容显式保存（E10）─── */

.clipboard-save {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-subtle, rgba(127, 127, 127, 0.08));
}

.clipboard-save-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-tertiary);
  flex: 1;
}

.clipboard-save-btn {
  font-size: 24rpx;
  color: var(--accent, #4f46e5);
  padding: 8rpx 16rpx;
  flex-shrink: 0;
