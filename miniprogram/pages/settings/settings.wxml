<!--
  settings.wxml - 设置页
  主题 / 排版（字号·行距·字体）/ 阅读选项 / 其他

  分组依据是亲密性：字号、行距、字体是同一类决定（正文怎么排），
  此前它们各占一张卡片，与「主题」「网络图片」这些不同性质的设置并列，
  卡片数量堆到 6 张却看不出层级。现在归成 4 组，组内用 divider 分隔子项。

  每组都有 group-title —— 此前前 4 组有标题、后 2 组没有，
  同一种卡片长出两副样子，是重复原则最直接的破口。
-->
<view class="page {{themeClass}}">
  <!-- 1. 主题 -->
  <view class="settings-group">
    <text class="group-title">阅读主题</text>
    <view class="theme-options">
      <view
        class="theme-option {{settings.theme === 'light' ? 'active' : ''}}"
        data-theme="light"
        bindtap="setTheme"
      >
        <view class="theme-preview theme-preview-light">
          <text class="theme-preview-text">Aa</text>
        </view>
        <text class="theme-name">浅色</text>
      </view>
      <view
        class="theme-option {{settings.theme === 'dark' ? 'active' : ''}}"
        data-theme="dark"
        bindtap="setTheme"
      >
        <view class="theme-preview theme-preview-dark">
          <text class="theme-preview-text">Aa</text>
        </view>
        <text class="theme-name">深色</text>
      </view>
      <view
        class="theme-option {{settings.theme === 'sepia' ? 'active' : ''}}"
        data-theme="sepia"
        bindtap="setTheme"
      >
        <view class="theme-preview theme-preview-sepia">
          <text class="theme-preview-text">Aa</text>
        </view>
        <text class="theme-name">护眼</text>
      </view>
    </view>
  </view>

  <!-- 2. 排版：字号 / 行距 / 字体 -->
  <view class="settings-group">
    <text class="group-title">排版</text>

    <view class="field">
      <view class="field-label">
        <text>字号</text>
        <text class="field-value">{{settings.fontSize}}px</text>
      </view>
      <view class="slider-row">
        <text class="slider-label">小</text>
        <slider
          class="slider"
          min="12"
          max="24"
          step="1"
          value="{{settings.fontSize}}"
          activeColor="{{accentColor}}"
          block-size="24"
          bindchange="setFontSize"
        />
        <text class="slider-label">大</text>
      </view>
    </view>

    <view class="divider"></view>

    <view class="field">
      <view class="field-label">
        <text>行距</text>
        <text class="field-value">{{settings.lineHeight.toFixed(1)}}</text>
      </view>
      <view class="slider-row">
        <text class="slider-label">紧凑</text>
        <slider
          class="slider"
          min="1.2"
          max="2.4"
          step="0.1"
          value="{{settings.lineHeight}}"
          activeColor="{{accentColor}}"
          block-size="24"
          bindchange="setLineHeight"
        />
        <text class="slider-label">宽松</text>
      </view>
    </view>

    <view class="divider"></view>

    <view class="field">
      <view class="field-label">
        <text>字体</text>
      </view>
      <view class="font-options">
        <view
          class="font-option {{settings.fontFamily === 'system' ? 'active' : ''}}"
          data-font="system"
          bindtap="setFontFamily"
        >
          <text style="font-family: var(--font-family);">系统默认</text>
        </view>
        <view
          class="font-option {{settings.fontFamily === 'serif' ? 'active' : ''}}"
          data-font="serif"
          bindtap="setFontFamily"
        >
          <text style="font-family: var(--font-serif);">衬线体</text>
        </view>
        <view
          class="font-option {{settings.fontFamily === 'mono' ? 'active' : ''}}"
          data-font="mono"
          bindtap="setFontFamily"
        >
          <text style="font-family: var(--font-mono);">等宽体</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 3. 阅读选项 -->
  <view class="settings-group">
    <text class="group-title">阅读选项</text>
    <view class="switch-row">
      <view class="switch-info">
        <text class="switch-title">网络图片</text>
        <text class="switch-desc">加载文档里的外链图片。会向图片服务器暴露 IP 与阅读行为，关闭后显示占位</text>
      </view>
      <switch checked="{{settings.networkImages}}" bindchange="setNetworkImages" color="{{accentColor}}" />
    </view>
    <view class="divider"></view>
    <view class="switch-row">
      <view class="switch-info">
        <text class="switch-title">屏幕常亮</text>
        <text class="switch-desc">阅读时保持屏幕不熄灭</text>
      </view>
      <switch checked="{{settings.keepScreenOn}}" bindchange="setKeepScreenOn" color="{{accentColor}}" />
    </view>
  </view>

  <!--
    4. 文字编码（ADR-15）
    阅读页导航栏原本常驻一个编码切换按钮，对不懂「GBK / Big5」的人是噪音，
    移到这里并配说明。这是**始终可达**的那份入口；乱码时的一键快捷入口
    在阅读页（.encoding-notice），两者是同一个动作的两条路。

    ⚠️ 编码是**单文档**属性，不是全局偏好 —— 为一份 GBK 文档选了 GBK，
    不该让下一份 UTF-8 文档也按 GBK 解。所以这里改的只是当前那份文档，
    下面的小字必须把这一点说清楚。
  -->
  <view class="settings-group">
    <text class="group-title">文字编码</text>
    <text class="encoding-desc">文档打开后满屏乱码，多半是编码识别错了。在这里换一种重新解读。</text>

    <block wx:if="{{encodingAvailable}}">
      <view class="encoding-current">
        <text class="encoding-current-label">当前文档</text>
        <text class="encoding-current-name ellipsis-1">{{encodingFileName || '未命名'}}</text>
      </view>
      <view class="encoding-options">
        <view
          class="encoding-option {{item === currentEncoding ? 'active' : ''}}"
          wx:for="{{encodingList}}"
          wx:key="*this"
          data-encoding="{{item}}"
          bindtap="setEncoding"
        >{{item}}</view>
      </view>
      <text class="encoding-note">只对当前这份文档生效，打开新文档会重新自动识别</text>
    </block>

    <text class="encoding-empty" wx:else>{{encodingEmptyHint}}</text>
  </view>

  <!-- 5. 其他：缓存 / 关于 -->
  <view class="settings-group">
    <text class="group-title">其他</text>
    <view class="action-row" bindtap="clearCache">
      <text class="action-title">清除缓存</text>
      <text class="action-value">{{cacheSizeText}}</text>
      <text class="action-arrow">›</text>
    </view>
    <!-- 告警紧贴「清除缓存」，它是那一行的附属说明，不是独立条目 -->
    <view class="storage-warn" wx:if="{{storageWarn}}">
      <text class="storage-warn-text">存储空间即将用满，建议清除缓存</text>
    </view>
    <view class="divider"></view>
    <view class="action-row" bindtap="showAbout">
      <text class="action-title">关于</text>
      <text class="action-value">v1.0.0</text>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <view class="page-tail"></view>
</view>
