/* settings.wxss - 设置页样式
 *
 * 数值一律走令牌（styles/tokens.wxss，由 core/tokens/design.js 生成）。
 * 不要在这里写 rpx / 色值字面量 —— tests/test-tokens.js 会拦。
 */

.page {
  min-height: 100vh;
  background-color: var(--bg-secondary);
  padding: var(--space-6) 0;
}

.settings-group {
  margin: 0 var(--space-6) var(--space-6);
  padding: var(--space-8);
  background-color: var(--bg-primary);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card) var(--shadow);
}

.group-title {
  font-size: var(--text-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-secondary);
  margin-bottom: var(--space-6);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.group-value {
  font-size: var(--text-md);
  color: var(--accent);
  font-weight: var(--weight-medium);
}

/* 主题选择 */
.theme-options {
  display: flex;
  justify-content: space-around;
}

.theme-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
}

.theme-preview {
  width: var(--size-theme-swatch-w);
  height: var(--size-theme-swatch-h);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--bw-focus) solid transparent;
  transition: border-color var(--motion-fast);
}

.theme-option.active .theme-preview {
  border-color: var(--accent);
}

/* 三个色块各显示一套主题的配色，所以用不了 var(--bg-primary)
 * —— 那永远是**当前**主题的值。这组 --preview-* 令牌由 gen_tokens.js
 * 从同一份主题表生成，改主题色时预览自动跟着变。 */
.theme-preview-light {
  background-color: var(--preview-light-bg);
}

.theme-preview-light .theme-preview-text {
  color: var(--preview-light-text);
}

.theme-preview-dark {
  background-color: var(--preview-dark-bg);
}

.theme-preview-dark .theme-preview-text {
  color: var(--preview-dark-text);
}

.theme-preview-sepia {
  background-color: var(--preview-sepia-bg);
}

.theme-preview-sepia .theme-preview-text {
  color: var(--preview-sepia-text);
}

.theme-preview-text {
  font-size: var(--text-2xl);
  font-weight: var(--weight-semibold);
}

.theme-name {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.theme-option.active .theme-name {
  color: var(--accent);
  font-weight: var(--weight-medium);
}

/* 滑块 */
.slider-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.slider-label {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
  white-space: nowrap;
}

.slider {
  flex: 1;
}

/* 字体选择 */
.font-options {
  display: flex;
  gap: var(--space-4);
}

.font-option {
  flex: 1;
  padding: var(--space-6) var(--space-4);
  text-align: center;
  border-radius: var(--radius-lg);
  background-color: var(--bg-tertiary);
  font-size: var(--text-lg);
  color: var(--text-secondary);
  transition: all var(--motion-fast);
}

.font-option.active {
  background-color: var(--accent-bg);
  color: var(--accent);
  font-weight: var(--weight-medium);
}

/* 开关行 */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) 0;
}

.switch-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-right: var(--space-6);
}

.switch-title {
  font-size: var(--text-xl);
  color: var(--text-primary);
}

.switch-desc {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  line-height: var(--leading-tight);
}

.settings-group .divider {
  margin: var(--space-6) 0;
}

/* 操作行 */
.action-row {
  display: flex;
  align-items: center;
  padding: var(--space-2) 0;
}

.action-title {
  flex: 1;
  font-size: var(--text-xl);
  color: var(--text-primary);
}

.action-value {
  font-size: var(--text-md);
  color: var(--text-tertiary);
  margin-right: var(--space-3);
}

.action-arrow {
  font-size: var(--text-2xl);
  color: var(--text-tertiary);
}

/* 存储告警 */
.storage-warn {
  padding: var(--space-4) 0 var(--space-1);
}

.storage-warn-text {
  font-size: var(--text-sm);
  color: var(--warn);
}

/* 页尾留白：底部工具栏/安全区之外再垫一段，最后一条内容不会贴边 */
.page-tail {
  height: var(--size-spinner);
}
