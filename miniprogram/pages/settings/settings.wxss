/* settings.wxss - 设置页样式
 *
 * 数值一律走令牌（styles/tokens.wxss，由 core/tokens/design.js 生成）。
 * 不要在这里写 rpx / 色值字面量 —— tests/test-tokens.js 会拦。
 */

.page {
  min-height: 100vh;
  background-color: var(--bg-secondary);
  padding: var(--space-8) 0;
}

/* 左右外边距与首页内容区一致（同走 --size-page-gutter）——
 * 此前设置页是 space-6，两个页面的内容左边缘差 8rpx，
 * 来回切换时能看出边缘在跳。所以这条边距不能自己取值，
 * 必须和首页共用同一个令牌。 */
.settings-group {
  margin: 0 var(--size-page-gutter) var(--space-8);
  padding: var(--space-8);
  background-color: var(--bg-primary);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card) var(--shadow);
}

/* 分组标签。此前是 28rpx / semibold / 二级灰，与它统领的 30rpx 内容标题
 * 只差 2rpx，看起来是同级而非上级。压到 24rpx、退到三级灰、放宽字距，
 * 让它明确是「标签」而不是「一条内容」。 */
.group-title {
  display: block;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--text-tertiary);
  letter-spacing: var(--tracking-wide);
  margin-bottom: var(--space-6);
}

/* ─── 组内子项 ─── */

.field-label {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  font-size: var(--text-xl);
  color: var(--text-primary);
  margin-bottom: var(--space-4);
}

.field-value {
  font-size: var(--text-md);
  color: var(--accent);
  font-weight: var(--weight-medium);
}

/* ─── 主题选择 ─── */

/* 与 .font-options 同一套布局：等宽填满。
 * 此前这里是 space-around 而字体那组是 flex:1，两组三选一控件
 * 长得不一样，是重复原则最容易被忽略的破口。 */
.theme-options {
  display: flex;
  flex-direction: row;
  gap: var(--space-4);
}

.theme-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
}

/* 容器（.theme-option）等宽，色块本身保持固定尺寸并居中 ——
 * 等宽容器负责让三列间距均匀，色块比例不受屏宽影响。
 *
 * ⚠️ 非选中态的描边必须是可见的 --border，不能是 transparent：
 * 浅色主题下 .theme-preview-light 是 #ffffff，卡片底色 --bg-primary
 * 也是 #ffffff —— 描边一透明，这个色块就整块消失，只剩「Aa」浮在空中。
 * 选中态只把描边换成 accent，宽度不变，所以切换时不会有跳动。 */
.theme-preview {
  width: var(--size-theme-swatch-w);
  height: var(--size-theme-swatch-h);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--bw-focus) solid var(--border);
  transition: border-color var(--motion-fast);
}

.theme-option.active .theme-preview {
  border-color: var(--accent);
}

/* 三个色块各显示一套主题的配色，所以用不了 var(--bg-primary)
 * —— 那永远是**当前**主题的值。这组 --preview-* 令牌由 gen_tokens.js
 * 从同一份主题表生成，改主题色时预览自动跟着变。 */
.theme-preview-light {
  background-color: var(--preview-light-bg);
}

.theme-preview-light .theme-preview-text {
  color: var(--preview-light-text);
}

.theme-preview-dark {
  background-color: var(--preview-dark-bg);
}

.theme-preview-dark .theme-preview-text {
  color: var(--preview-dark-text);
}

.theme-preview-sepia {
  background-color: var(--preview-sepia-bg);
}

.theme-preview-sepia .theme-preview-text {
  color: var(--preview-sepia-text);
}

.theme-preview-text {
  font-size: var(--text-2xl);
  font-weight: var(--weight-semibold);
}

.theme-name {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.theme-option.active .theme-name {
  color: var(--accent);
  font-weight: var(--weight-medium);
}

/* ─── 滑块 ─── */
.slider-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.slider-label {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
  white-space: nowrap;
}

.slider {
  flex: 1;
}

/* ─── 字体选择 ─── */
.font-options {
  display: flex;
  gap: var(--space-4);
}

/* 内边距保持 space-6：算下来行高约 90rpx≈45px，刚好在 44px 触控目标之上。
   为了视觉紧凑压扁它会掉到 37px，不划算。 */
.font-option {
  flex: 1;
  padding: var(--space-6) var(--space-4);
  text-align: center;
  border-radius: var(--radius-lg);
  background-color: var(--bg-tertiary);
  font-size: var(--text-lg);
  color: var(--text-secondary);
  transition: all var(--motion-fast);
}

.font-option.active {
  background-color: var(--accent-bg);
  color: var(--accent);
  font-weight: var(--weight-medium);
}

/* ─── 开关行 ─── */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) 0;
}

.switch-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-right: var(--space-6);
}

.switch-title {
  font-size: var(--text-xl);
  color: var(--text-primary);
}

.switch-desc {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  line-height: var(--leading-tight);
}

.settings-group .divider {
  margin: var(--space-6) 0;
}

/* ─── 操作行 ─── */
.action-row {
  display: flex;
  align-items: center;
  padding: var(--space-2) 0;
}

.action-title {
  flex: 1;
  font-size: var(--text-xl);
  color: var(--text-primary);
}

.action-value {
  font-size: var(--text-md);
  color: var(--text-tertiary);
  margin-right: var(--space-3);
}

.action-arrow {
  font-size: var(--text-2xl);
  color: var(--text-tertiary);
}

/* 存储告警：紧贴上方的「清除缓存」行，是它的附属说明 */
.storage-warn {
  padding: var(--space-3) 0 0;
}

.storage-warn-text {
  font-size: var(--text-sm);
  color: var(--warn);
}

/* 页尾留白：底部工具栏/安全区之外再垫一段，最后一条内容不会贴边 */
.page-tail {
  height: var(--size-spinner);
}

/* ─── 文字编码（ADR-15）─── */

.encoding-desc {
  display: block;
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-5);
}

.encoding-current {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.encoding-current-label {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.encoding-current-name {
  flex: 1;
  min-width: 0;
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

/* 六个选项排成两行三列。用 wrap 而不是等分单行：
   「UTF-16LE」这种长标签在单行三等分里会被挤到换行，六个格子高度参差 */
.encoding-options {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.encoding-option {
  flex: 1 1 28%;
  padding: var(--space-4) var(--space-2);
  text-align: center;
  border-radius: var(--radius-lg);
  background-color: var(--bg-tertiary);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  transition: all var(--motion-fast);
}

.encoding-option.active {
  background-color: var(--accent-bg);
  color: var(--accent);
  font-weight: var(--weight-medium);
}

.encoding-note {
  display: block;
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  margin-top: var(--space-4);
}

.encoding-empty {
  display: block;
  font-size: var(--text-sm);
  color: var(--text-tertiary);
  line-height: var(--leading-normal);
}
